MAX_OUTPUT_TOKENS=2048
MAX_SYSTEM_PROMPT_LENGTH=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NUM_CTX=8192
NUM_BATCH=128
OLLAMA_TIMEOUT_MS=300000
RAG_TOP_K=5
RAG_TEMPERATURE=0.1
MAX_UPLOAD_MB=20
MAX_PDF_CHARS=2000000
MAX_IMAGE_BYTES=5242880
MAX_MESSAGES_PER_SESSION=2000
MAX_MESSAGE_CONTENT_LENGTH=200000
